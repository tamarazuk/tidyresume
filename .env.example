# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cloudflare Browser Rendering API (for PDF export)
# Get your account ID from the Cloudflare dashboard URL or Overview page
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
# Create an API token at: My Profile → API Tokens → Create Token
# Required permission: Browser Rendering: Edit
CLOUDFLARE_BROWSER_RENDERING_API_TOKEN=your_api_token_here
