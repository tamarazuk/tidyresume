generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Resume {
  id        String   @id
  slug      String?  @unique
  title     String
  content   String
  userEmail String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authTokens AuthToken[]

  @@map("resumes")
}

model AuthToken {
  id        String    @id @default(cuid())
  token     String    @unique
  resumeId  String
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@map("auth_tokens")
}
